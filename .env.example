# URL base de la API (sin slash final)
# Local:  http://localhost:8080/api/v1
# Con el proxy de Vite también puedes usar: /api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Producción: Vite usa .env.production en `npm run build`
# VITE_API_BASE_URL=https://backvendri-production.up.railway.app/api/v1
